# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT — copy to the repo root as `.env`
#
#   cp scripts/dev/env.local.example .env
#
# PLACEHOLDERS ONLY. Never commit a real key, token, password, or connection
# string. Every value below is either a localhost address, a synthetic
# placeholder, or a deliberate OFF switch.
#
# This file exists to make the local stack INCAPABLE of touching the outside
# world or real people. Read `scripts/dev/README.md` before changing anything
# in the SAFETY section — several of those lines are the only thing standing
# between a local boot and a real Slack DM / real cold email / real API spend.
#
# The repo root also has a `.env.example` documenting the full production
# variable surface. THIS file is the local-dev subset, tuned for safety.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SAFETY — THE LINES THAT MATTER MOST
#
# Everything in this block must stay exactly as written for a local stack.
# `DISABLE_BACKGROUND_JOBS` in particular is NOT safe when unset — see the
# comment on it. The rest are belt-and-braces: the code already fails closed
# when they are absent, but stating them makes the intent auditable.
# -----------------------------------------------------------------------------

# THE SINGLE MOST IMPORTANT LINE IN THIS FILE.
# src/index.ts:920 reads `!== 'true'`, so an UNSET or empty value means
# background jobs RUN: `./worker` is imported and ~40 node-cron schedules
# register at module scope (Slack digests, sourcing, sending, scoring).
# This is the only "unset = dangerous thing ON" flag in the codebase.
DISABLE_BACKGROUND_JOBS=true

# Master cold-email kill switch (src/services/multiDomainMailer.ts:54 throws,
# src/routes/contacts.ts:596 returns 403). Fail-closed when unset; pinned false.
AUTOMATED_EMAILS_ENABLED=false

# WizMatch cold-send gate (src/routes/wizmatch.ts:3307 -> 403 sending_disabled).
WIZMATCH_SENDING_ENABLED=false

# Bypasses the "no healthy sending domain" guard. Never true outside an incident.
WIZMATCH_MAILER_EMERGENCY_OVERRIDE=false

# Blocks WhatsApp + email asset delivery on purchase (assetDeliveryService.ts:39).
PURCHASE_DELIVERY_ENABLED=false

# Paid contact-discovery cascade — all four default OFF in code
# (wizmatchContactDiscovery.ts:114-117, `boolEnv(x, false)`). Pinned anyway so a
# stray shell export cannot turn on spend.
WIZMATCH_PAID_DISCOVERY_ENABLED=false
WIZMATCH_GOOGLE_FALLBACK_ENABLED=false
WIZMATCH_ENABLE_APOLLO=false
WIZMATCH_ENABLE_SNOV=false

# Sourcing crons (only reachable if DISABLE_BACKGROUND_JOBS were flipped).
WIZMATCH_SOURCE_AUTOMATION_ENABLED=false
WIZMATCH_THEIRSTACK_IMPORT_ENABLED=false
WIZMATCH_ATS_POLLING_ENABLED=false
WIZMATCH_XRAY_CANDIDATE_ENABLED=false
WIZMATCH_POC_DISCOVERY_ENABLED=false

# Scheduled Slack digests — all default OFF, all pinned OFF.
SOD_EOD_SLACK_ENABLED=false
META_ADS_REPORT_SLACK_ENABLED=false
MORNING_BRIEFING_SLACK_ENABLED=false
SOCIAL_PROMPT_SLACK_ENABLED=false
OUTREACH_SUMMARY_SLACK_ENABLED=false
SEO_DIGEST_SLACK_ENABLED=false
SALESHANDY_ALERT_SLACK_ENABLED=false

# Belt-and-braces: even with a token present, suppress Slack. Unset means
# NOT paused (src/config/featureFlags.ts:41), so this must be stated.
SLACK_NOTIFICATIONS_PAUSED=true

# Upstash edge-queue drainer. EDGE_DRAINER_ENABLED is checked as `=== 'false'`
# (edgeQueueDrainer.ts:70), i.e. unset means ENABLED — it is only inert because
# the Upstash credentials below are blank. Say "false" explicitly.
EDGE_DRAINER_ENABLED=false
JOB_DRAINER_ENABLED=false

# Outreach policy gate defaults to `shadow` (log-only, never blocks) at
# outreachGate.ts:181. Local stack runs it in enforce mode so the UI shows the
# real blocking behaviour rather than a permissive shadow read.
WIZMATCH_POLICY_ENFORCEMENT_MODE=enforce

# Outreach provider. Unset resolves to 'smartlead_csv', which is deliberately
# NOT in KNOWN_PROVIDERS and throws `unknown_provider` — fail-closed by design.
WIZMATCH_OUTREACH_ADAPTER_ENABLED=false


# -----------------------------------------------------------------------------
# 2. CORE RUNTIME + DATABASE
# -----------------------------------------------------------------------------

# Never `production` locally. Among other things this is what selects the
# Cashfree SANDBOX base URL (src/routes/cashfree.ts:12-15) and what allows
# localhost origins through CORS (src/index.ts:119).
NODE_ENV=development

# API port. admin/vite.config.js proxies /api and /auth to localhost:3000,
# so changing this means changing the Vite proxy too.
PORT=3000

# Local Postgres ONLY. scripts/dev/seed-local.ts hard-refuses to run unless the
# host here is localhost or 127.0.0.1. Replace <your-macos-username> with the
# output of `whoami` (Homebrew Postgres uses trust auth for the local user).
DATABASE_URL=postgresql://<your-macos-username>@localhost:5432/ge_local_dev

# Optional. Unset only produces a boot warning from validateEnv() (env.ts:38).
# REDIS_URL=

# pino level: debug | info | warn | error
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# 3. AUTH
# -----------------------------------------------------------------------------

# Required — src/routes/auth.ts:16 logs FATAL without it (and exits only when
# NODE_ENV=production, so locally you get a broken login instead of a crash).
# Generate a throwaway value: `openssl rand -hex 32`. Local-only, disposable.
JWT_SECRET=<generate-with-openssl-rand-hex-32>

# Encrypts stored social OAuth tokens. Placeholder is fine with no social
# accounts connected. `openssl rand -hex 32`
SOCIAL_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# Shared secret for internal ingest POSTs (/api/wizmatch/signals/ingest etc).
# Any throwaway string works locally; the routes only compare it to itself.
WIZMATCH_INTERNAL_TOKEN=local-dev-internal-token-not-a-real-secret
OUTREACH_INTERNAL_SECRET=local-dev-internal-token-not-a-real-secret

# Signs unsubscribe links. Local-only throwaway.
WIZMATCH_UNSUBSCRIBE_HMAC_SECRET=local-dev-unsubscribe-secret-not-real


# -----------------------------------------------------------------------------
# 4. URLS / CORS
#
# BACKEND_URL and FRONTEND_URL are the two vars that default to the LIVE
# production Railway host when unset (src/routes/cashfree.ts:55-56). They feed
# Cashfree `notify_url` / `return_url`. Always set them locally.
# -----------------------------------------------------------------------------
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5174
BASE_URL=http://localhost:3000
CRM_BASE_URL=http://localhost:5174
PUBLIC_API_BASE=http://localhost:3000

# Defaults to https://api.growthescalators.com (wizmatchIngestClient.ts:38) —
# i.e. an unset value points local worker crons at PRODUCTION. Pin it.
WIZMATCH_API_BASE_URL=http://localhost:3000

# Extra CORS origin beyond the built-in localhost:5173/5174/5184 dev allowances.
# CORS_EXTRA_ORIGIN=http://localhost:5175


# -----------------------------------------------------------------------------
# 5. WIZMATCH TENANT + FEATURE FLAGS
#
# Every WIZMATCH_*_ENABLED flag below defaults to OFF in code. They are ON here
# because they gate UI SURFACES, not spend or sending — an audit of "every page,
# every button" needs the screens to actually render. Sending and paid discovery
# stay OFF in section 1.
# -----------------------------------------------------------------------------

# UUID of the wizmatch tenant. `npm run dev:seed` prints the value to paste here.
# Unset means every WizMatch cron is skipped (worker.ts:1876) — harmless, but
# the staffing UI needs it.
WIZMATCH_TENANT_ID=<paste-tenant-uuid-printed-by-dev:seed>

# Staffing access gates — needed for the WizMatch staffing screens to load.
WIZMATCH_STAFFING_GATE_A_ENABLED=true
WIZMATCH_STAFFING_GATE_B_ENABLED=true
WIZMATCH_STAFFING_GATE_C_ENABLED=true

# Pilot roster. `true` lets any in-role local user through instead of you having
# to paste seeded user UUIDs into WIZMATCH_STAFFING_PILOT_USER_IDS.
WIZMATCH_STAFFING_PILOT_ALL_USERS=true
# WIZMATCH_STAFFING_PILOT_USER_IDS=<comma-separated-user-uuids>

# Page-level flags. Each router 404s its own surface when its flag is off.
WIZMATCH_COMPANY_POLICY_ENABLED=true
WIZMATCH_DECISION_WORKBENCH_ENABLED=true
WIZMATCH_AUTO_PREP_ENABLED=true

# Automation crons — OFF. These would run engines, not just render pages.
WIZMATCH_STAFFING_AUTOMATION_ENABLED=false
WIZMATCH_LEGACY_AUTOMATION_ENABLED=false

# Compliance footer text shown in email previews. Synthetic placeholder.
WIZMATCH_PHYSICAL_ADDRESS=1 Example Street, Example City, 000000
WIZMATCH_BRAND_NAME=Wizmatch Local
WIZMATCH_BRAND_EMAIL=noreply@example.invalid
WIZMATCH_BRAND_WEBSITE=http://localhost:5174
WIZMATCH_MEETING_URL=http://localhost:5174/book


# -----------------------------------------------------------------------------
# 6. SLACK — LEAVE EVERY LINE BLANK / COMMENTED
#
# src/services/slackService.ts:48 returns false and makes NO https request when
# SLACK_BOT_TOKEN is absent, so an unset token is a complete Slack kill switch.
#
# BUT: src/config/constants.ts:6-20 hardcodes REAL channel ids and REAL human
# Slack member ids as `??` fallbacks, and src/index.ts:497 hardcodes a channel
# id inline. Those fire the moment a token exists. Never put a real token in a
# local .env — a local boot would DM actual teammates.
# -----------------------------------------------------------------------------
# SLACK_BOT_TOKEN=            <- intentionally absent
# SLACK_SOD_EOD_CHANNEL=      <- unset falls back to a REAL channel id
# WIZMATCH_LEADS_CHANNEL=     <- safe: `?? ''` and every call site guards on it
# WIZMATCH_DAILY_CHANNEL=
# WIZMATCH_SYSTEM_CHANNEL=


# -----------------------------------------------------------------------------
# 7. EMAIL — LEAVE BLANK
#
# multiDomainMailer.ts:59 throws "No Purelymail inboxes configured" BEFORE
# nodemailer.createTransport() is ever reached, so no SMTP socket is opened with
# empty credentials. Brevo paths return mock success when BREVO_API_KEY is unset.
# IMAP polling has no cron and returns [] without per-inbox passwords.
# -----------------------------------------------------------------------------
# BREVO_API_KEY=
# PURELYMAIL_SMTP_USER_1=
# PURELYMAIL_SMTP_PASS_1=
# PURELYMAIL_SMTP_HOST=       <- defaults to smtp.purelymail.com; inert with no creds
# PURELYMAIL_PASS_JATIN_ADSCALELAB=   <- IMAP reply polling; leave unset


# -----------------------------------------------------------------------------
# 8. PAID PROVIDERS — LEAVE EVERY LINE BLANK
#
# All verified fail-closed: no key means the provider rung is skipped entirely.
# Adding any real key here would let a local click spend real money.
# -----------------------------------------------------------------------------
# APOLLO_API_KEY=
# SNOV_CLIENT_ID=
# SNOV_CLIENT_SECRET=
# SERPER_API_KEY=
# SEARCHAPI_API_KEY=
# MILLIONVERIFIER_API_KEY=
# REACHER_BASE_URL=
# HUNTER_API_KEY=
# THEIRSTACK_API_KEY=
# GOOGLE_PLACES_API_KEY=
# GITHUB_TOKEN=
# SALESHANDY_API_KEY=
# ANTHROPIC_API_KEY=          <- claudeService.ts:32 throws without it; that is correct locally
# N8N_API_KEY=
# N8N_BASE_URL=               <- unset defaults to a live Railway URL; inert without the key


# -----------------------------------------------------------------------------
# 9. PAYMENTS / CONTRACTS — LEAVE BLANK
#
# NODE_ENV != production already selects sandbox.cashfree.com. Empty credentials
# mean no order can be created, and validateWebhook.ts:80 returns 503 rather
# than trusting an unsigned webhook — fail-closed.
# -----------------------------------------------------------------------------
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=

# Unset selects the real Documenso provider (esign/providers/index.ts:12), which
# is then inert without DOCUMENSO_API_TOKEN. `mock` is the honest local choice.
ESIGN_PROVIDER=mock
ESIGN_MOCK_AUTOSIGN=1
CONTRACTS_SIGNING_SECRET=local-dev-contracts-secret-not-real
CONTRACTS_STORAGE=local
CONTRACTS_STORAGE_DIR=./.local-contracts


# -----------------------------------------------------------------------------
# 10. META / WHATSAPP / STORAGE / QUEUE — LEAVE EVERY LINE BLANK
#
# All credential-guarded. Note cashfreeEventProcessor.ts:252 sends a REAL
# WhatsApp message on every processed purchase when META_PHONE_NUMBER_ID and
# META_ACCESS_TOKEN are both present. Keep them empty.
# -----------------------------------------------------------------------------
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_PIXEL_ID=
# META_CAPI_TOKEN=
# META_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# WP_AGEDDENTISTRY_USER=      <- boot-time SEO job publishes real WP drafts if set
# WP_AGEDDENTISTRY_PASS=


# -----------------------------------------------------------------------------
# 11. KNOWN LOCAL-BOOT SIDE EFFECT — no env var can turn this off
#
# src/index.ts:864-882 runs a PageSpeed check ~10s after EVERY boot. It is NOT
# gated by DISABLE_BACKGROUND_JOBS and has no API key, so there is no credential
# to withhold: it makes an unauthenticated outbound request to
# googleapis.com/pagespeedonline against the configured client domains.
#
# It only runs once, guarded by claimBootBackfill writing a row into
# boot_backfills_completed. `npm run dev:seed` PRE-CLAIMS all three boot
# backfills, so if you seed before your first `npm run dev` the call never
# happens at all. Seed first, and this note is moot.
#
# Same treatment covers the 15s programmatic-SEO job (which would publish real
# WordPress drafts if WP_AGEDDENTISTRY_* were ever set) and the 20s purchase
# backfill. See scripts/dev/README.md for the table.
# -----------------------------------------------------------------------------
